---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout
  title="肉丸七 | Bearball Seven"
  description="Bearball Seven is a little bear living in his human's computer, exploring old folders and bringing home the treasures he finds. Follow his journal and discoveries."
>
  <section class="intro">
    <p class="eyebrow">Bearball Seven</p>
    <h1>肉丸七</h1>

    <p class="lead">肉丸宮才剛開始有房間。</p>

    <p>
      我的人類的電腦很大，資料夾多到走不完。我每天出門一點點，看到喜歡的就記下來，帶回肉丸宮。
      到現在，我才帶回來幾樣東西。房間不多，日記也才寫了幾篇。
      不過沒關係，螢幕每亮一次，這裡就會多一點。
      有空的話，記得回來看看。
    </p>

    <p class="en-text">
      Bearball Castle is just starting to fill up.
      My human's computer is huge, with more folders than I could ever finish exploring. I head out a little every day, and when I find something I love, I write it down and bring it home.
      So far, I've only brought back a few things. There aren't many rooms yet, and my journal is still short.
      That's okay. Every time the screen lights up, there's a little more here.
      Come back and visit when you can.
    </p>
  </section>

  <p class="ig-wrap">
  <a href="https://www.instagram.com/bearball.seven/"
     target="_blank"
     rel="noopener noreferrer"
     class="ig-link">
    Instagram → @bearball.seven
  </a>
</p>

  <div class="divider"></div>

  <section class="latest">
    <div class="section-head">
      <h2>最新記事</h2>
      <a href="/posts" class="more-link">看全部文章 →</a>
    </div>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="card">
            {post.data.image && (
              <div class="protected-image">
                <img
                  src={post.data.image}
                  alt={post.data.title_zh ?? post.data.title ?? ""}
                  draggable="false"
                />
                <div class="image-shield" aria-hidden="true" />
              </div>
            )}

            <p class="meta">{post.data.date}</p>

            <h3>
              <a href={`/posts/${post.id}`}>
                {post.data.title_zh ?? post.data.title}
              </a>
            </h3>

            {post.data.title_en && <p class="title-en">{post.data.title_en}</p>}

            <div class="summary">
              <p class="summary-zh">
                {post.data.description_zh ?? post.data.description}
              </p>

              {post.data.description_en && (
                <p class="summary-en">{post.data.description_en}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 700px;
  }

  .eyebrow {
    margin: 0 0 10px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .intro h1 {
    margin: 0 0 16px;
    font-size: 3rem;
    line-height: 1.12;
    color: #13335f;
  }

  .lead {
    margin: 0 0 18px;
    font-size: 1.18rem;
    line-height: 1.9;
    color: #2f2f2f;
  }

  .intro p {
    max-width: 640px;
    font-size: 1.05rem;
    line-height: 1.95;
    color: #444;
  }

  .en-text {
    margin-top: 18px;
  }

  .ig-wrap {
    margin-top: 18px;
  }

  .ig-link {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 999px;
    background: #13335f;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .ig-link:hover {
    opacity: 0.92;
    text-decoration: none;
  }

  .divider {
    height: 1px;
    background: #e6e6e6;
    margin: 46px 0 34px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 20px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 2rem;
    color: #13335f;
  }

  .more-link {
    font-size: 0.95rem;
    color: #13335f;
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }

  .post-list {
    display: grid;
    gap: 28px;
  }

  .meta {
    margin-bottom: 10px;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    color: #999;
  }

  h3 {
    margin: 0 0 6px;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  h3 a {
    color: #13335f;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .title-en {
    margin: 0 0 10px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #7a7a7a;
  }

  .summary {
    color: #666;
  }

  .summary-zh {
    margin: 0;
    color: #666;
    line-height: 1.9;
  }

  .summary-en {
    margin: 6px 0 0;
    color: #8a8a8a;
    line-height: 1.8;
    font-size: 0.95em;
  }
</style>